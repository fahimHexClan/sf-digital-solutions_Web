# Copy to .env.local (never commit .env.local). All values are optional today.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Form service URL (e.g. a Formspree endpoint). Empty = forms hand over via WhatsApp.
NEXT_PUBLIC_QUOTE_FORM_ENDPOINT=

# Supabase accounts (public values; data is protected by row level security).
# URL and anon key: Supabase dashboard -> Project Settings -> API. Never use the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
